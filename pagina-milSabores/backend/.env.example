# DB_USER es solo el nombre de usuario (por ejemplo root), NO root@localhost.
# DB_PASSWORD es la contraseña real de XAMPP; nunca la subas a Git.
DB_URL=jdbc:mariadb://localhost:3306/ferreteria_los_maestros
DB_DRIVER=org.mariadb.jdbc.Driver
DB_USER=your_mariadb_user
DB_PASSWORD=your_mariadb_password
JPA_DIALECT=org.hibernate.dialect.MariaDBDialect
DDL_AUTO=update
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION_MS=3600000
